# Halcyon: let your user set the battery charge limit (the 80 % / full charge chip in the utilities box) without root, group video.
# Only batteries that have a limit (charge_control_end_threshold) are touched. install.sh copies this to /etc/udev/rules.d/.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT*", TEST=="charge_control_end_threshold", RUN+="/bin/chgrp video /sys/class/power_supply/%k/charge_control_end_threshold", RUN+="/bin/chmod g+w /sys/class/power_supply/%k/charge_control_end_threshold"
