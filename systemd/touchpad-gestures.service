[Unit]
Description=Halcyon touchpad edge gestures (volume / brightness / track skip)
After=graphical-session.target
# never a restart storm: at most 5 starts per minute, then the unit stays failed (see: systemctl --user status touchpad-gestures)
StartLimitIntervalSec=60
StartLimitBurst=5
# a failure (after the restarts gave up) is explained by the local AI as a notification (halcyon-explain@.service)
OnFailure=halcyon-explain@%n.service

[Service]
ExecStart=%h/.config/Halcyon/bin/touchpad-gestures
# on-failure, not always: a clean exit stays stopped. Exit 78 = "you are not in the input group": restarting cannot fix that.
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=78
# gestures run brightnessctl / wpctl / playerctl, so PATH must include them (pipewire user session needs XDG_RUNTIME_DIR)
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Hardening (same set the Halcyon timer units already use). NoNewPrivileges is left off on purpose: helper scripts may need sudo/setuid tools.
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Started from hyprland/execs.lua. Needs read access to /dev/input (be in the `input` group, then log in again).

# Tuning the 3 / 4 finger pinch vs swipe decision (optional; see src/touchpad-gestures/src/classify.rs). Uncomment, then:
#   systemctl --user daemon-reload && systemctl --user restart touchpad-gestures
# and watch what it decides with:  journalctl --user -u touchpad-gestures -f
#Environment=HALCYON_GESTURE_DEBUG=1
#Environment=HALCYON_PINCH_MIN=0.018
#Environment=HALCYON_SWIPE_MIN=0.035
#Environment=HALCYON_PINCH_BIAS=0.5
