[Unit]
Description=Halcyon: reminders to back up / run the safety check (only started while a reminder is on, see Settings > Backup)
# a failure (after the restarts gave up) is explained by the local AI as a notification (halcyon-explain@.service)
OnFailure=halcyon-explain@%n.service

[Service]
Type=oneshot
ExecStart=%h/.config/Halcyon/scripts/remind.sh check
# Hardening that cannot change what this job does (no namespaces needed, so it works in the user manager everywhere):
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
