#!/bin/sh
# halcyon-session: what the login screen (greetd) runs for a session. Installed root-owned in /usr/local/share/halcyon-greeter/.
#
# greetd runs "exec $@" through the user's shell with $@ UNQUOTED, so every argument is split at spaces and its quotes are NOT
# re-read. A script or "sh -c '...'" passed as ONE argument therefore falls apart (the session then ends in the same second,
# with nothing written). So the greeter passes only plain words: this script's path, then the session command as separate words
# (no spaces or quotes inside a word). Everything that needs real shell syntax happens in here.
#
# It leaves a trace of every login-screen session in ~/.cache/island/greeter-session.log: when it started, as which user, and how
# it ended (exit code). No line at all after a failed login = the session died before this script ran (greetd sourcing
# /etc/profile or ~/.profile, or PAM). Only the session's own output goes into that file.
l="$HOME/.cache/island/greeter-session.log"
mkdir -p "$HOME/.cache/island" 2>/dev/null
[ "$(stat -c %s "$l" 2>/dev/null || echo 0)" -gt 200000 ] && : > "$l"
{
  echo "== $(date '+%F %T') session from the login screen: $*"
  echo "-- user=$(id -un) HOME=$HOME SHELL=${SHELL:-} tty=$(tty 2>&1) XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset} XDG_SESSION_ID=${XDG_SESSION_ID:-unset} XDG_VTNR=${XDG_VTNR:-unset}"
} >>"$l" 2>&1
if [ "$#" -eq 0 ]; then
  echo "== $(date '+%F %T') no session command was given" >>"$l"
  exit 1
fi
"$@" >>"$l" 2>&1
rc=$?
echo "== $(date '+%F %T') session command ended: exit $rc" >>"$l"
exit "$rc"
