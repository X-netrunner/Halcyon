# Bash completion for sysmode

_sysmode_completions() {
    local cur prev subcommands options
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    subcommands="secure relaxed cyber stealth hacking lockdown boot-late status verify check doctor counterscan reapply logs dossier daemons help"
    options="--hotspot --no-hotspot --persona --help -h"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${subcommands} ${options}" -- "${cur}") )
        return 0
    fi

    case "${prev}" in
        stealth|hacking)
            COMPREPLY=( $(compgen -W "--hotspot --no-hotspot --persona" -- "${cur}") )
            ;;
        --persona)
            COMPREPLY=( $(compgen -W "cisco synology ubuntu debian default" -- "${cur}") )
            ;;
        *)
            COMPREPLY=()
            ;;
    esac
}

complete -F _sysmode_completions sysmode
