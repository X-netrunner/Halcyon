# ---------------------------------------------------------------------------
# Stealth cleanup (runs at the start of every mode switch)
# ---------------------------------------------------------------------------

cleanup_stealth() {
    # 1. Restore original hostname & hosts file mapping
    if [[ -f /etc/sysmode.orig-hostname ]]; then
        local orig_hostname
        orig_hostname=$(cat /etc/sysmode.orig-hostname)
        echo "[*] Restoring original hostname to $orig_hostname..."
        hostnamectl set-hostname "$orig_hostname" || true
        rm -f /etc/sysmode.orig-hostname
        rm -f /etc/sysmode.persona
    fi
    if [[ -f /etc/hosts ]]; then
        echo "[*] Cleaning up transient hostname mapping in /etc/hosts..."
        sed -i '/# sysmode-hostname/d' /etc/hosts
    fi

    # 1b. Restore original Bluetooth adapter alias
    if [[ -f /etc/sysmode.orig-bt-alias ]]; then
        echo "[*] Restoring original Bluetooth adapter alias..."
        bluetoothctl system-alias "$(cat /etc/sysmode.orig-bt-alias)" >/dev/null 2>&1 || true
        rm -f /etc/sysmode.orig-bt-alias
    fi

    # 2. Restore Machine ID
    if mountpoint -q /etc/machine-id; then
        echo "[*] Restoring original Machine ID..."
        umount /etc/machine-id || umount -l /etc/machine-id || true
    fi

    # 3. Restore DNS
    if [[ -f /etc/resolv.conf.orig ]]; then
        echo "[*] Restoring original resolv.conf..."
        chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
        cp /etc/resolv.conf.orig /etc/resolv.conf
        rm -f /etc/resolv.conf.orig
    fi

    # 4. Unmount RAM-backed workspace (back up any leftover files first)
    if mountpoint -q "$STEALTH_WORKSPACE"; then
        if [[ -n "$(ls -A "$STEALTH_WORKSPACE" 2>/dev/null)" ]]; then
            echo "[!] Files found in RAM workspace! Creating a secure backup..."
            local backup_file
            backup_file="$SYS_HOME/Workspace/stealth_backup_$(date +%Y%m%d_%H%M%S).tar.gz"
            echo "[*] Backing up RAM workspace files to $backup_file..."
            tar -czf "$backup_file" -C "$STEALTH_WORKSPACE" .
            chown "$SYS_USER:$SYS_USER" "$backup_file"
            chmod 600 "$backup_file"
            echo "[+] Secure backup saved successfully."
        fi
        echo "[*] Unmounting RAM-backed workspace..."
        umount -l "$STEALTH_WORKSPACE" || true
    fi

    # 5. Restore default/balanced power profile (battery-aware; on battery
    #    leave auto-power-manager in charge, which prefers power-saver)
    if on_ac_power; then
        if command -v powerprofilesctl &>/dev/null; then
            echo "[*] Restoring power profile to balanced..."
            powerprofilesctl set balanced || true
        elif command -v asusctl &>/dev/null; then
            echo "[*] Restoring power profile to Balanced..."
            asusctl profile set Balanced || true
        fi
    else
        echo "[*] On battery — leaving power profile untouched."
    fi

    # 6. Re-enable IPv6, default TTL, and TCP timestamps in the running kernel
    echo "[*] Re-enabling IPv6 on all interfaces..."
    sysctl -w net.ipv6.conf.all.disable_ipv6=0 >/dev/null 2>&1 || true
    sysctl -w net.ipv6.conf.default.disable_ipv6=0 >/dev/null 2>&1 || true
    local iface
    for iface in /proc/sys/net/ipv6/conf/*; do
        if [[ -d "$iface" ]]; then
            sysctl -w "net.ipv6.conf.$(basename "$iface").disable_ipv6=0" >/dev/null 2>&1 || true
        fi
    done
    sysctl -w net.ipv4.ip_default_ttl=64 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.tcp_timestamps=1 >/dev/null 2>&1 || true

    # Restore persistent journald configuration
    if [[ -f /etc/systemd/journald.conf.d/sysmode-stealth.conf ]]; then
        echo "[*] Restoring persistent journald configuration..."
        rm -f /etc/systemd/journald.conf.d/sysmode-stealth.conf
        systemctl restart systemd-journald || true
    fi

    # 7. Restore original MAC address settings in NetworkManager
    if [[ -f /etc/NetworkManager/conf.d/sysmode-mac-rand.conf ]]; then
        echo "[*] Restoring original MAC address settings in NetworkManager..."
        rm -f /etc/NetworkManager/conf.d/sysmode-mac-rand.conf
        systemctl reload NetworkManager || systemctl restart NetworkManager || true
    fi

    # 8. Clean up subnet isolation & honeypot ban rules in UFW
    if command -v ufw >/dev/null; then
        echo "[*] Restoring default firewall rules..."
        local rule_num
        while read -r rule_num; do
            rule_num=$(echo "$rule_num" | tr -d ' ')
            if [[ -n "$rule_num" && "$rule_num" =~ ^[0-9]+$ ]]; then
                ufw --force delete "$rule_num" >/dev/null || true
            fi
        done < <(ufw status numbered 2>/dev/null | grep -E "sysmode-isolation|sysmode-local|reverse shells|recon-deceiver-ban|recon-deceiver-decoy" | awk -F'[][]' '{print $2}' | sort -rn)
        ufw reload >/dev/null || true
    fi

    # Clean up OS detection spoofing iptables rules
    if command -v iptables >/dev/null; then
        echo "[*] Cleaning up decoy iptables rules..."
        iptables -D INPUT -p tcp --tcp-flags ALL NONE -j DROP -m comment --comment "recon-deceiver-decoy" 2>/dev/null || true
        iptables -D INPUT -p tcp --tcp-flags SYN,FIN SYN,FIN -j DROP -m comment --comment "recon-deceiver-decoy" 2>/dev/null || true
        iptables -D INPUT -p tcp --tcp-flags ALL URG,PSH,FIN -j DROP -m comment --comment "recon-deceiver-decoy" 2>/dev/null || true
    fi

    # 9. Stop deceptive SSID broadcast if active
    if [[ -f /etc/sysmode.decoy-wifi ]]; then
        local decoy_dev
        decoy_dev=$(cat /etc/sysmode.decoy-wifi)
        echo "[*] Stopping deceptive WiFi AP on interface $decoy_dev..."
        nmcli device disconnect "$decoy_dev" >/dev/null 2>&1 || true
        rm -f /etc/sysmode.decoy-wifi
    fi

    # 10. Remove hidepid=2 from /etc/fstab if it was added by lockdown mode
    if grep -q 'sysmode-hidepid' /etc/fstab 2>/dev/null; then
        echo "[*] Removing hidepid=2 from /etc/fstab..."
        sed -i '/# sysmode-hidepid/d' /etc/fstab
        sed -i '/proc.*hidepid=2.*sysmode/d' /etc/fstab
        mount -o remount /proc >/dev/null 2>&1 || true
    fi

    # 11. Disable and remove late-boot systemd hardening service
    if [[ -f /etc/systemd/system/sysmode-late.service ]]; then
        echo "[*] Removing late-boot systemd hardening service..."
        systemctl disable sysmode-late.service 2>/dev/null || true
        rm -f /etc/systemd/system/sysmode-late.service
        systemctl daemon-reload
    fi

    # 12. Remove lockdown idle-shell timeout profile
    if [[ -f /etc/profile.d/sysmode-timeout.sh ]]; then
        echo "[*] Removing lockdown idle-shell timeout..."
        rm -f /etc/profile.d/sysmode-timeout.sh
    fi

    # 13. Undo lockdown account expiry on the sysmode user
    echo "[*] Clearing lockdown account expiry for $SYS_USER..."
    chage -E -1 "$SYS_USER" 2>/dev/null || true

    # 14. Stop tcpdump MAC scanner logging if active
    stop_tcpdump

    # 14b. Stop Cowrie SSH honeypot and release the port-22 handoff marker
    stop_cowrie

    # 15. Restore volatile login accounting files (wtmp/btmp/lastlog)
    for f in wtmp btmp lastlog; do
        if mountpoint -q "/var/log/$f" 2>/dev/null; then
            umount "/var/log/$f" 2>/dev/null || true
        fi
    done

    # 15b. Restore shell history (fish + bash) BEFORE deleting the volatile
    # source dir — unmounting after rm -rf leaves the mount pointing into a
    # deleted inode, which breaks fish history writes.
    # Use lazy unmount (-l) so it detaches even when a shell is open;
    # the holder keeps its stale view but new opens get the real dir.
    if mountpoint -q "$SYS_HOME/.local/share/fish" 2>/dev/null; then
        umount -l "$SYS_HOME/.local/share/fish" 2>/dev/null || true
    fi
    rm -f /etc/profile.d/sysmode-stealth-history.sh
    rm -rf /run/sysmode-volatile

    # 17. Restore NTP configuration
    if [[ -f /etc/systemd/timesyncd.conf.d/sysmode-stealth.conf ]]; then
        echo "[*] Restoring default NTP configuration..."
        rm -f /etc/systemd/timesyncd.conf.d/sysmode-stealth.conf
        systemctl restart systemd-timesyncd || true
    fi

    # 18. Re-enable disk-backed swap
    swapon -a 2>/dev/null || true

    # 19. Remove extra stealth OS-fingerprint iptables rules
    if command -v iptables >/dev/null; then
        iptables -D INPUT -p tcp --tcp-flags SYN,RST SYN,RST -j DROP -m comment --comment "recon-deceiver-decoy" 2>/dev/null || true
        iptables -D INPUT -p tcp --tcp-flags ALL ALL -j DROP -m comment --comment "recon-deceiver-decoy" 2>/dev/null || true
    fi
}

