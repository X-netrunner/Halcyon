#!/usr/bin/env bash
# Halcyon/sysmode/sysmode  (install.sh copies it to /usr/local/bin/sysmode)
# Toggle system hardening profiles for daily use vs. cybersecurity learning.

set -euo pipefail

# --- Configuration (overridable via /etc/sysmode.conf) ---
# /etc/sysmode.conf first, so a SYS_USER / SYS_HOME set there wins; then fill in what is still unset. The old default was
# the hard-coded user "netrunner": on any other account SCRIPTS_DIR pointed at a folder that does not exist, so the
# honeypot and IDS scripts were never found. Now: sudo's caller, else the login user, else the first normal account.
[[ -f /etc/sysmode.conf ]] && source /etc/sysmode.conf
if [[ -z "${SYS_USER:-}" ]]; then
    SYS_USER="${SUDO_USER:-}"
    [[ -n "$SYS_USER" && "$SYS_USER" != root ]] || SYS_USER="$(logname 2>/dev/null || true)"
    [[ -n "$SYS_USER" && "$SYS_USER" != root ]] || SYS_USER="$(getent passwd | awk -F: '$3>=1000 && $3<60000 {print $1; exit}')"
    [[ -n "$SYS_USER" ]] || SYS_USER=netrunner
fi
if [[ -z "${SYS_HOME:-}" ]]; then
    SYS_HOME="$(getent passwd "$SYS_USER" | cut -d: -f6)"
    [[ -n "$SYS_HOME" ]] || SYS_HOME="/home/$SYS_USER"
fi
# helper scripts (recon-deceiver.py, log-analyst.py, attacker-dossier.py) ship next to this file in the rice

# `hx` (Rust, installed by install.sh) replaces the Python dossier / IDS; the .py files stay as a fallback
run_dossier() {
    if command -v hx >/dev/null 2>&1; then hx dossier "$@"
    elif [[ -f "$SCRIPTS_DIR/attacker-dossier.py" ]]; then python3 "$SCRIPTS_DIR/attacker-dossier.py" "$@"
    else echo "  Dossier helper missing (install hx: ./install.sh)."; fi
}
SCRIPTS_DIR="${SCRIPTS_DIR:-$SYS_HOME/.config/Halcyon/sysmode}"
LOGS_DIR="$SYS_HOME/logs"
AUDIT_LOG_DIR="$LOGS_DIR/audit"
STEALTH_WORKSPACE="$SYS_HOME/Workspace/Stealth"
SYSMODE_SYSCTL="/etc/sysctl.d/99-sysmode.conf"
HARDENING_CONF="/etc/sysctl.d/99-hardening.conf"
PTRACE_CONF="/etc/sysctl.d/99-ptrace.conf"
SYSMODE_MODE="/etc/sysmode.mode"
SYSMODE_BLACKLIST="/etc/modprobe.d/sysmode-blacklist.conf"
SYSMODE_AUDIT_RULES="/etc/audit/rules.d/sysmode-audit.rules"

DECOY_HOTSPOT=0

# Load configuration if exists
if [[ -f /etc/sysmode.conf ]]; then
    # shellcheck source=/dev/null
    source /etc/sysmode.conf
fi

USER_UID="$(id -u "$SYS_USER" 2>/dev/null || echo 1000)"
USER_GID="$(id -g "$SYS_USER" 2>/dev/null || echo 1000)"

COMPILERS=(gcc g++ clang make as ld rustc)

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

update_config() {
    local key="$1" val="$2"
    mkdir -p /etc
    if [[ -f /etc/sysmode.conf ]] && grep -q "^${key}=" /etc/sysmode.conf; then
        sed -i "s|^${key}=.*|${key}=${val}|" /etc/sysmode.conf
    else
        echo "${key}=${val}" >> /etc/sysmode.conf
        chmod 644 /etc/sysmode.conf
    fi
}

set_mode_file() {
    printf '%s\n' "$1" > "$SYSMODE_MODE"
    chmod 644 "$SYSMODE_MODE"
}

# True when running on AC power (or when no battery is present). Lets power
# profile changes be battery-aware instead of blindly forcing performance.
on_ac_power() {
    local supply
    for supply in /sys/class/power_supply/*/online; do
        [[ -f "$supply" ]] || continue
        if [[ "$(cat "$supply" 2>/dev/null)" == "1" ]]; then
            return 0
        fi
    done
    if compgen -G '/sys/class/power_supply/BAT*' >/dev/null 2>&1; then
        return 1
    fi
    return 0
}

# Start a daemon detached from this shell (it must outlive the console / terminal that ran sysmode), keep its output in
# $LOGS_DIR/<name>.out instead of /dev/null, and say plainly if it died on start.
#   start_bg <name> <pidfile> <command...>
start_bg() {
    local name="$1" pidfile="$2"; shift 2
    local logf="$LOGS_DIR/$name.out" pid
    mkdir -p "$LOGS_DIR"
    setsid nohup "$@" >>"$logf" 2>&1 </dev/null &
    pid=$!
    echo "$pid" > "$pidfile"
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
        echo "[+] $name started (pid $pid, log: $logf)"
    else
        echo "[!] $name exited right after starting. Last lines of $logf:"
        tail -n 8 "$logf" 2>/dev/null | sed 's/^/      /'
    fi
}

stop_pidfile() {
    local pidfile="$1"
    if [[ -f "$pidfile" ]]; then
        kill "$(cat "$pidfile")" 2>/dev/null || true
        rm -f "$pidfile"
    fi
}

stop_daemons() {
    echo "[*] Stopping recon deception daemon..."
    systemctl stop recon-deceiver.service 2>/dev/null || true
    stop_pidfile /var/run/recon-deceiver.pid
    pkill -f recon-deceiver.py 2>/dev/null || true
    echo "[*] Stopping lightweight IDS log analyst..."
    systemctl stop log-analyst.service 2>/dev/null || true
    stop_pidfile /var/run/log-analyst.pid
    pkill -f log-analyst.py 2>/dev/null || true
    pkill -f "hx ids" 2>/dev/null || true
}

# --- Cowrie SSH honeypot (Docker) -----------------------------------------
# Runs the Cowrie container on host port 22 (mapped to container 2222). The
# recon-deceiver banner decoy skips port 22 while the /run/cowrie.active
# marker is present. userdb.txt is set to accept all logins so brute-forcers
# get straight into the fake shell and we capture their commands.

COWRIE_MARKER="/run/cowrie.active"
COWRIE_CFG_DIR="/etc/cowrie"
COWRIE_LOG_DIR="$LOGS_DIR/cowrie"
COWRIE_STATE_DIR="$LOGS_DIR/cowrie-lib"

write_cowrie_config() {
    mkdir -p "$COWRIE_CFG_DIR"
    local host
    host=$(hostname)
    cat > "$COWRIE_CFG_DIR/cowrie.cfg" <<EOF
[honeypot]
hostname = $host
log_path = var/log/cowrie
state_path = var/lib/cowrie
logtype = plain
timezone = system
sensor_name = $host

[shell]
kernel_version = 3.13.0-160-generic
kernel_build_string = #110-Ubuntu SMP Tue Apr 13 11:22:11 UTC 2021
hardware_platform = x86_64
operating_system = GNU/Linux
ssh_version = OpenSSH_6.6.1p1, OpenSSL 1.0.1f 6 Jan 2014

[ssh]
enabled = true
version = SSH-2.0-OpenSSH_6.6.1p1 Ubuntu-2ubuntu2
listen_endpoints = tcp:2222:interface=0.0.0.0

[telnet]
enabled = false

[output_jsonlog]
enabled = true
logfile = \${honeypot:log_path}/cowrie.json
EOF
    cat > "$COWRIE_CFG_DIR/userdb.txt" <<'EOF'
root:x:root
root:x:toor
root:x:123456
root:x:password
root:x:admin
root:x:passw0rd
root:x:P@ssw0rd
root:x:P@ssw0rd!
root:x:h4ckm3
admin:x:admin
admin:x:password
admin:x:123456
admin:x:UB_Admin_P@ss_2026_Secure
ubuntu:x:ubuntu
ubuntu:x:123456
ubuntu:x:toor
sys_admin:x:UB_Admin_P@ss_2026_Secure
dba:x:UB_Admin_P@ss_2026_Secure
tomcat:x:*
oracle:x:*
user:x:user
test:x:test
guest:x:guest
*:x:root
*:x:toor
*:x:123456
*:x:password
*:x:admin
*:x:guest
*:x:test
*:x:changeme
*:x:*
EOF
    chmod 644 "$COWRIE_CFG_DIR/cowrie.cfg" "$COWRIE_CFG_DIR/userdb.txt"
}

start_cowrie() {
    command -v docker >/dev/null 2>&1 || { echo "[!] docker not available; keeping banner decoy on port 22"; return 1; }
    if ! docker info >/dev/null 2>&1; then
        echo "[!] docker daemon not running; keeping banner decoy on port 22"
        return 1
    fi
    write_cowrie_config
    mkdir -p "$COWRIE_LOG_DIR" "$COWRIE_STATE_DIR/tty" \
             "$COWRIE_STATE_DIR/downloads" "$COWRIE_STATE_DIR/uploads"
    chown -R 999:999 "$COWRIE_LOG_DIR" "$COWRIE_STATE_DIR" 2>/dev/null || true
    chmod 755 "$COWRIE_LOG_DIR" "$COWRIE_STATE_DIR" 2>/dev/null || true
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx cowrie; then
        docker start cowrie >/dev/null 2>&1 || true
    else
        docker run -d --name cowrie \
            -p 22:2222 \
            -v "$COWRIE_LOG_DIR":/cowrie/cowrie-git/var/log/cowrie \
            -v "$COWRIE_STATE_DIR":/cowrie/cowrie-git/var/lib/cowrie \
            -v "$COWRIE_CFG_DIR/cowrie.cfg":/cowrie/cowrie-git/etc/cowrie.cfg:ro \
            -v "$COWRIE_CFG_DIR/userdb.txt":/cowrie/cowrie-git/etc/userdb.txt:ro \
            cowrie/cowrie:latest >/dev/null 2>&1
    fi
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx cowrie; then
        touch "$COWRIE_MARKER"
        echo "[+] Cowrie SSH honeypot started on port 22 (banner decoy stood down)"
    else
        echo "[!] Cowrie failed to start; keeping banner decoy on port 22"
        rm -f "$COWRIE_MARKER"
    fi
}

stop_cowrie() {
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx cowrie; then
        echo "[*] Stopping Cowrie SSH honeypot..."
        docker stop cowrie >/dev/null 2>&1 || true
    fi
    rm -f "$COWRIE_MARKER"
}

stop_tcpdump() {
    stop_pidfile /var/run/sysmode-tcpdump.pid
    pkill -f "tcpdump -i .* -e -n -l" 2>/dev/null || true
}

ensure_logs() {
    mkdir -p "$AUDIT_LOG_DIR"
    chown "$SYS_USER:$SYS_USER" "$LOGS_DIR"
    chmod 700 "$LOGS_DIR"
    chown root:root "$AUDIT_LOG_DIR"
    chmod 700 "$AUDIT_LOG_DIR"

    echo "[*] Enabling sudo logging..."
    mkdir -p /etc/sudoers.d
    cat > /etc/sudoers.d/sysmode-logging <<EOF
Defaults logfile="$LOGS_DIR/sudo.log"
EOF
    chmod 440 /etc/sudoers.d/sysmode-logging
}

remove_sudo_logging() {
    echo "[*] Removing sudo logging configuration..."
    rm -f /etc/sudoers.d/sysmode-logging
}

set_ufw_sysctl() {
    local forward="$1" icmp="$2" policy="$3"
    if [[ -f /etc/ufw/sysctl.conf ]]; then
        sed -i "s|^#\?net/ipv4/ip_forward=.*|net/ipv4/ip_forward=${forward}|" /etc/ufw/sysctl.conf
        sed -i "s|^#\?net/ipv4/icmp_echo_ignore_all=.*|net/ipv4/icmp_echo_ignore_all=${icmp}|" /etc/ufw/sysctl.conf
    fi
    if [[ -f /etc/default/ufw ]]; then
        sed -i "s|^DEFAULT_FORWARD_POLICY=.*|DEFAULT_FORWARD_POLICY=\"${policy}\"|" /etc/default/ufw
    fi
}

set_ufw_logging() {
    local level="$1"
    if command -v ufw >/dev/null; then
        ufw logging "$level" >/dev/null || true
    fi
}

set_hardening_conf() {
    local hardening="$1" ptrace="$2"
    if [[ "$hardening" == "enable" && -f "$HARDENING_CONF.bak" ]]; then
        echo "[*] Re-enabling 99-hardening.conf..."
        mv "$HARDENING_CONF.bak" "$HARDENING_CONF"
    elif [[ "$hardening" == "disable" && -f "$HARDENING_CONF" ]]; then
        echo "[*] Temporarily disabling 99-hardening.conf..."
        mv "$HARDENING_CONF" "$HARDENING_CONF.bak"
    fi
    if [[ "$ptrace" == "enable" && -f "$PTRACE_CONF.bak" ]]; then
        echo "[*] Re-enabling 99-ptrace.conf..."
        mv "$PTRACE_CONF.bak" "$PTRACE_CONF"
    elif [[ "$ptrace" == "disable" && -f "$PTRACE_CONF" ]]; then
        echo "[*] Temporarily disabling 99-ptrace.conf..."
        mv "$PTRACE_CONF" "$PTRACE_CONF.bak"
    fi
}

set_compilers() {
    local mode="$1"
    local perm=755
    [[ "$mode" == "secure" || "$mode" == "lockdown" ]] && perm=700
    if [[ "$perm" == "700" ]]; then
        echo "[*] Restricting compiler access to root..."
    else
        echo "[*] Restoring compiler permissions for all users..."
    fi
    local exe
    for exe in "${COMPILERS[@]}"; do
        chmod "$perm" "/usr/bin/$exe" 2>/dev/null || true
    done
}

write_blacklist() {
    echo "[*] Blacklisting DCCP, SCTP, RDS, TIPC, and FireWire modules..."
    if [[ -f /etc/modprobe.d/blacklist.conf ]]; then
        sed -i '/dccp\|sctp\|rds\|tipc/d' /etc/modprobe.d/blacklist.conf
    fi
    cat > "$SYSMODE_BLACKLIST" <<'EOF'
install dccp /bin/true
install sctp /bin/true
install rds /bin/true
install tipc /bin/true
install firewire-core /bin/true
install firewire-ohci /bin/true
install thunderbolt /bin/true
EOF
}

remove_blacklist() {
    echo "[*] Restoring access to blacklisted network and storage modules..."
    rm -f "$SYSMODE_BLACKLIST"
}

write_audit_rules() {
    local mode="$1"
    [[ -d /etc/audit/rules.d ]] || return 0
    echo "[*] Setting up active auditd security rules..."
    case "$mode" in
        lockdown)
            cat > "$SYSMODE_AUDIT_RULES" <<'EOF'
# Watch critical configuration files
-w /etc/passwd -p wa -k passwd_changes
-w /etc/shadow -p wa -k shadow_changes
-w /etc/sudoers -p wa -k sudoers_changes
-w /etc/login.defs -p wa -k logindefs_changes
-w /etc/hosts -p wa -k hosts_changes
-w /etc/ssh/sshd_config -p wa -k sshd_config

# Watch execution of admin tools
-w /usr/bin/sudo -p x -k sudo_exec
-w /usr/bin/passwd -p x -k passwd_exec

# Complete system logging:
-a always,exit -F arch=b64 -S execve -k exec_all
-a always,exit -F arch=b32 -S execve -k exec_all

# Watch all network socket connections
-a always,exit -F arch=b64 -S connect -S accept -S socket -k net_all
-a always,exit -F arch=b32 -S connect -S accept -S socket -k net_all
EOF
            ;;
        stealth)
            cat > "$SYSMODE_AUDIT_RULES" <<'EOF'
# Watch critical configuration files
-w /etc/passwd -p wa -k passwd_changes
-w /etc/shadow -p wa -k shadow_changes
-w /etc/sudoers -p wa -k sudoers_changes

# Watch execution of admin tools
-w /usr/bin/sudo -p x -k sudo_exec

# Audit outbound network connections
-a always,exit -F arch=b64 -S connect -k hack_connect
-a always,exit -F arch=b32 -S connect -k hack_connect
EOF
            ;;
        *)
            cat > "$SYSMODE_AUDIT_RULES" <<'EOF'
# Watch critical configuration files
-w /etc/passwd -p wa -k passwd_changes
-w /etc/shadow -p wa -k shadow_changes
-w /etc/sudoers -p wa -k sudoers_changes
-w /etc/login.defs -p wa -k logindefs_changes
-w /etc/hosts -p wa -k hosts_changes

# Watch execution of admin tools
-w /usr/bin/sudo -p x -k sudo_exec
-w /usr/bin/passwd -p x -k passwd_exec

# Watch outbound network connection calls
-a always,exit -F arch=b64 -S connect -k net_conn
-a always,exit -F arch=b32 -S connect -k net_conn
EOF
            ;;
    esac

    sed -i "s|^log_file = .*|log_file = ${AUDIT_LOG_DIR}/audit.log|" /etc/audit/auditd.conf
    systemctl restart auditd >/dev/null 2>&1 || true

    if command -v augenrules >/dev/null; then
        augenrules --load >/dev/null 2>&1 || true
    elif command -v auditctl >/dev/null; then
        auditctl -R "$SYSMODE_AUDIT_RULES" >/dev/null 2>&1 || true
    fi
}

remove_audit_rules() {
    [[ -f "$SYSMODE_AUDIT_RULES" ]] || return 0
    echo "[*] Disabling active auditd security rules..."
    rm -f "$SYSMODE_AUDIT_RULES"
    sed -i 's|^log_file = .*|log_file = /var/log/audit/audit.log|' /etc/audit/auditd.conf
    systemctl restart auditd >/dev/null 2>&1 || true

    if command -v augenrules >/dev/null; then
        augenrules --load >/dev/null 2>&1 || true
    elif command -v auditctl >/dev/null; then
        auditctl -D >/dev/null 2>&1 || true
    fi
}

write_banner() {
    local mode="$1"
    if [[ "$mode" == "secure" || "$mode" == "lockdown" ]]; then
        echo "[*] Deploying legal login warning banner..."
        cat > /etc/issue <<'EOF'
======================================================================
  WARNING: Authorized Access Only. All activities are monitored.
  Unauthorised use is strictly prohibited and subject to prosecution.
======================================================================
EOF
        cp /etc/issue /etc/issue.net 2>/dev/null || true
    else
        echo "[*] Restoring default login banners..."
        printf "Arch Linux (\\r) (\\l)\n" > /etc/issue
        printf "Arch Linux (\\r) (\\l)\n" > /etc/issue.net 2>/dev/null || true
    fi
}

set_login_defs() {
    local mode="$1"
    [[ -f /etc/login.defs ]] || return 0
    if [[ "$mode" == "secure" || "$mode" == "lockdown" ]]; then
        sed -i 's/^UMASK.*/UMASK\t\t027/' /etc/login.defs
        sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS\t90/' /etc/login.defs
        sed -i 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS\t1/' /etc/login.defs
        sed -i 's/^PASS_WARN_AGE.*/PASS_WARN_AGE\t7/' /etc/login.defs
        sed -i 's/^#\?SHA_CRYPT_MIN_ROUNDS.*/SHA_CRYPT_MIN_ROUNDS 5000/' /etc/login.defs
        sed -i 's/^#\?SHA_CRYPT_MAX_ROUNDS.*/SHA_CRYPT_MAX_ROUNDS 5000/' /etc/login.defs
    else
        sed -i 's/^UMASK.*/UMASK\t\t022/' /etc/login.defs
        sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS\t99999/' /etc/login.defs
        sed -i 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS\t0/' /etc/login.defs
        sed -i 's/^PASS_WARN_AGE.*/PASS_WARN_AGE\t7/' /etc/login.defs
        sed -i 's/^SHA_CRYPT_MIN_ROUNDS.*/#SHA_CRYPT_MIN_ROUNDS 5000/' /etc/login.defs
        sed -i 's/^SHA_CRYPT_MAX_ROUNDS.*/#SHA_CRYPT_MAX_ROUNDS 5000/' /etc/login.defs
    fi
}

set_shell_umask() {
    local mode="$1"
    local f
    if [[ "$mode" == "secure" || "$mode" == "lockdown" ]]; then
        echo "[*] Hardening shell umask settings..."
        for f in /etc/profile /etc/bash.bashrc; do
            [[ -f "$f" ]] || continue
            if ! grep -q "umask 027" "$f"; then
                printf '\n# Set default safe umask\numask 027\n' >> "$f"
            fi
        done
    else
        echo "[*] Restoring shell umask settings to 022..."
        for f in /etc/profile /etc/bash.bashrc; do
            [[ -f "$f" ]] || continue
            sed -i '/# Set default safe umask/,/umask 027/d' "$f"
            sed -i '/umask 027/d' "$f"
        done
    fi
}

set_core_dumps() {
    local mode="$1"
    [[ -f /etc/security/limits.conf ]] || return 0
    if [[ "$mode" == "secure" || "$mode" == "lockdown" ]]; then
        echo "[*] Disabling core dumps..."
    else
        echo "[*] Restoring core dump limits..."
    fi
    sed -i '/\*               hard    core/d' /etc/security/limits.conf
    sed -i '/\*               soft    core/d' /etc/security/limits.conf
    if [[ "$mode" == "secure" || "$mode" == "lockdown" ]]; then
        echo "*               hard    core            0" >> /etc/security/limits.conf
        echo "*               soft    core            0" >> /etc/security/limits.conf
    fi
}

set_home_perms() {
    local mode="$1"
    if [[ "$mode" == "lockdown" ]]; then
        echo "[*] Restricting $SYS_USER home directory permissions..."
        chmod 750 "$SYS_HOME"
        chown "$SYS_USER:$SYS_USER" "$SYS_HOME"
    elif [[ "$mode" == "secure" ]]; then
        echo "[*] Restricting $SYS_USER home directory permissions..."
        chmod 700 "$SYS_HOME"
    else
        echo "[*] Restoring $SYS_USER home directory permissions..."
        chmod 711 "$SYS_HOME"
    fi
}

write_lynis() {
    local mode="$1"
    echo "[*] Creating Lynis custom profile overrides..."
    mkdir -p /etc/lynis
    if [[ "$mode" == "lockdown" ]]; then
        cat > /etc/lynis/custom.prf <<'EOF'
