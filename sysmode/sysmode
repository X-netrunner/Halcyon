skip-test=PKGS-7322
skip-test=CRYP-7902
skip-test=FILE-6310
skip-test=NAME-4028
skip-test=NAME-4406
skip-test=LOGG-2154
skip-test=LOGG-2190
skip-test=TOOL-5002
skip-test=BOOT-5264
EOF
    else
        cat > /etc/lynis/custom.prf <<'EOF'
# Custom Lynis Profile Overrides
skip-test=PKGS-7322
skip-test=CRYP-7902
EOF
    fi
}

remove_lynis() {
    echo "[*] Removing Lynis custom profile overrides..."
    rm -f /etc/lynis/custom.prf
}

randomize_wallpaper() {
    echo "[*] Randomizing wallpaper..."
    # Halcyon's wallpaper layer (quickshell/wallpaper): ask the running instance for a new one
    sudo -u "$SYS_USER" env XDG_RUNTIME_DIR="/run/user/$USER_UID" \
        quickshell ipc -p "$SYS_HOME/.config/Halcyon/quickshell/wallpaper" call wallpaper next >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# Per-mode persistent sysctl configuration
# ---------------------------------------------------------------------------

append_key() {
    [[ -n "$2" ]] || return 0
    printf '%s = %s\n' "$1" "$2" >> "$SYSMODE_SYSCTL"
}

write_sysctl_mode() {
    local mode="$1"
    local fwd f6 pf pr icmp ldisc sd dis6 wscale
    local rdr srdr src lgm rfc dmesg kptr perf jit srq
    local ptrace bpf modules rpf ttl

    case "$mode" in
        secure)
            fwd=0; f6=0; pf=2; pr=2; icmp=0; ldisc=0; sd=0
            rdr=0; srdr=0; src=0; lgm=1; rfc=1
            dmesg=1; kptr=2; perf=3; jit=2; srq=0
            dis6=0; wscale=; ttl=
            ptrace=0; bpf=0; modules=; rpf=
            ;;
        lockdown)
            fwd=0; f6=0; pf=2; pr=2; icmp=1; ldisc=0; sd=0
            rdr=0; srdr=0; src=0; lgm=1; rfc=1
            dmesg=1; kptr=2; perf=3; jit=2; srq=0
            dis6=0; wscale=; ttl=
            ptrace=1; bpf=1; modules=; rpf=1
            ;;
        cyber)
            fwd=1; f6=1; pf=0; pr=0; icmp=0; ldisc=1; sd=2
            rdr=1; srdr=1; src=1; lgm=0; rfc=0
            dmesg=0; kptr=0; perf=2; jit=0; srq=16
            dis6=0; wscale=; ttl=
            ptrace=0; bpf=0; modules=; rpf=
            ;;
        stealth)
            fwd=1; f6=0; pf=0; pr=0; icmp=1; ldisc=1; sd=2
            rdr=1; srdr=1; src=1; lgm=0; rfc=0
            dmesg=0; kptr=0; perf=2; jit=0; srq=16
            dis6=1; wscale=1; ttl=64
            ptrace=0; bpf=0; modules=0; rpf=0
            ;;
        *)
            echo "[!] Unknown mode: $mode" >&2
            return 1
            ;;
    esac

    cat > "$SYSMODE_SYSCTL" <<EOF
# Dynamic Sysctl Overrides - ${mode^^} MODE
net.ipv4.ip_forward = $fwd
net.ipv6.conf.all.forwarding = $f6
net.ipv6.conf.default.forwarding = $f6
fs.protected_fifos = $pf
fs.protected_regular = $pr
net.ipv4.icmp_echo_ignore_all = $icmp
net.ipv6.icmp.echo_ignore_all = $icmp
dev.tty.ldisc_autoload = $ldisc
fs.suid_dumpable = $sd

# Ensure IPv6 and TCP timestamps are enabled/restored
net.ipv6.conf.all.disable_ipv6 = $dis6
net.ipv6.conf.default.disable_ipv6 = $dis6
net.ipv4.tcp_timestamps = 1

# Prevent man-in-the-middle attacks by disabling ICMP redirects
net.ipv4.conf.all.accept_redirects = $rdr
net.ipv4.conf.default.accept_redirects = $rdr
net.ipv4.conf.all.secure_redirects = $srdr
net.ipv4.conf.default.secure_redirects = $srdr
net.ipv6.conf.all.accept_redirects = $rdr
net.ipv6.conf.default.accept_redirects = $rdr

# Do not send ICMP redirects (we are not a router)
net.ipv4.conf.all.send_redirects = $srdr
net.ipv4.conf.default.send_redirects = $srdr

# Prevent source routing
net.ipv4.conf.all.accept_source_route = $src
net.ipv4.conf.default.accept_source_route = $src
net.ipv6.conf.all.accept_source_route = $src
net.ipv6.conf.default.accept_source_route = $src

# Enable Log Martians (impossible packets)
net.ipv4.conf.all.log_martians = $lgm
net.ipv4.conf.default.log_martians = $lgm

# Prevent RFC 1337 Time-Wait Assassination
net.ipv4.tcp_rfc1337 = $rfc

# Restrict dmesg access to root only
kernel.dmesg_restrict = $dmesg

# Restrict access to kernel pointers in /proc (kptr_restrict)
kernel.kptr_restrict = $kptr

# Restrict unprivileged performance events
kernel.perf_event_paranoid = $perf

# Harden BPF JIT compiler
net.core.bpf_jit_harden = $jit

# Magic SysRq key
kernel.sysrq = $srq
EOF

    append_key kernel.yama.ptrace_scope "$ptrace"
    append_key kernel.unprivileged_bpf_disabled "$bpf"
    append_key kernel.modules_disabled "$modules"
    append_key net.ipv4.conf.all.rp_filter "$rpf"
    append_key net.ipv4.conf.default.rp_filter "$rpf"
    append_key net.ipv4.ip_default_ttl "$ttl"
    append_key net.ipv4.tcp_window_scaling "$wscale"
}

