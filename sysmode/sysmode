# ---------------------------------------------------------------------------

detect_mode() {
    if [[ -f "$SYSMODE_MODE" ]]; then
        cat "$SYSMODE_MODE"
        return 0
    fi
    local ptrace forward compilers icmp_ignore
    ptrace=$(sysctl -n kernel.yama.ptrace_scope 2>/dev/null || echo "N/A")
    forward=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo "N/A")
    icmp_ignore=$(sysctl -n net.ipv4.icmp_echo_ignore_all 2>/dev/null || echo "0")
    if [[ -f /usr/bin/gcc ]] && [[ "$(stat -c '%a' /usr/bin/gcc 2>/dev/null)" == "700" ]]; then
        compilers="Strict (Root Only)"
    else
        compilers="Relaxed (All Users)"
    fi
    if [[ -f "$HARDENING_CONF" ]]; then
        echo "lockdown"
    elif [[ "$forward" == "0" && "$compilers" == "Strict (Root Only)" ]]; then
        echo "secure"
    elif [[ "$forward" == "1" && "$compilers" == "Relaxed (All Users)" && "$icmp_ignore" == "1" ]]; then
        echo "stealth"
    elif [[ "$forward" == "1" && "$compilers" == "Relaxed (All Users)" && "$icmp_ignore" == "0" ]]; then
        echo "cyber"
    else
        echo "custom"
    fi
}

