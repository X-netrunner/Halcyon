set_lockdown() {
    cleanup_stealth
    echo "[*] Switching to LOCKDOWN / FORTRESS Mode..."
    set_mode_file lockdown

    # 0. Pre-flight: ensure /boot is mounted before we lock anything
    echo "[*] Pre-flight: Ensuring /boot is mounted..."
    if ! mountpoint -q /boot; then
        echo "[!] /boot is not mounted — attempting to mount it now..."
        mount /boot 2>/dev/null && echo "[+] /boot mounted successfully." \
            || echo "[!] WARNING: Could not mount /boot. Late module lock may make it inaccessible!"
    else
        echo "[+] /boot is mounted — OK."
    fi

    stop_daemons
    set_ufw_sysctl 0 1 "DROP"
    set_hardening_conf enable disable

    # Pre-load essential filesystem & storage modules BEFORE locking the kernel
    echo "[*] Pre-loading essential filesystem modules before kernel lock..."
    local essential_modules=(vfat fat nls_cp437 nls_ascii nls_utf8 ext4 ext2 xfs btrfs f2fs dm_mod dm_crypt loop usb_storage uas nvme nvme_core ahci libahci aes aes_x86_64 sha256_ssse3 cbc ecb xts)
    local mod
    for mod in "${essential_modules[@]}"; do
        modprobe "$mod" 2>/dev/null || true
    done
    echo "[*] Essential modules pre-loaded."

    write_sysctl_mode lockdown
    sysctl --system >/dev/null 2>&1 || true

    # Force-apply parameters live
    sysctl -w net.ipv4.conf.all.log_martians=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.conf.default.log_martians=1 >/dev/null 2>&1 || true

    # Lock modules live for the current session
    echo "[*] Locking kernel module loading for current session..."
    sysctl -w kernel.modules_disabled=1 >/dev/null 2>&1 || true

    # Deploy late-boot service to apply the modules lock after boot completes
    echo "[*] Deploying late-boot hardening systemd service..."
    cat > /etc/systemd/system/sysmode-late.service <<'EOF'
[Unit]
Description=Late System Hardening (sysmode lockdown modules lock)
After=multi-user.target local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sysmode boot-late
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 /etc/systemd/system/sysmode-late.service
    systemctl daemon-reload
    systemctl enable sysmode-late.service >/dev/null 2>&1 || true

    # Configure UFW
    if command -v ufw >/dev/null; then
        ufw default deny incoming >/dev/null || true
        ufw default allow outgoing >/dev/null || true
        ufw deny 22/tcp >/dev/null || true
        ufw logging high >/dev/null || true
    fi
    ufw reload >/dev/null || true

    # Disable sshd service entirely in lockdown
    echo "[*] Disabling sshd service..."
    systemctl stop sshd 2>/dev/null || true
    systemctl mask sshd 2>/dev/null || true
    mkdir -p /etc/ssh/sshd_config.d
    cat > /etc/ssh/sshd_config.d/sysmode-lockdown.conf <<EOF
# Completely disable all SSH remote logins in LOCKDOWN mode
PasswordAuthentication no
PubkeyAuthentication no
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
EOF
    chmod 644 /etc/ssh/sshd_config.d/sysmode-lockdown.conf

    ensure_logs
    set_compilers lockdown
    write_blacklist
    write_audit_rules lockdown
    write_banner lockdown
    set_login_defs lockdown
    set_shell_umask lockdown
    set_core_dumps lockdown
    set_home_perms lockdown

    # Harden sshd_config permissions
    echo "[*] Hardening sshd_config permissions..."
    if [[ -f /etc/ssh/sshd_config ]]; then
        chmod 600 /etc/ssh/sshd_config
        chown root:root /etc/ssh/sshd_config
    fi

    # Enable process accounting
    echo "[*] Enabling process accounting..."
    if ! command -v accton &>/dev/null; then
        pacman -S --noconfirm --needed acct >/dev/null 2>&1 || true
    fi
    if command -v accton &>/dev/null; then
        mkdir -p /var/log/account
        touch /var/log/account/pacct
        chmod 640 /var/log/account/pacct
        accton /var/log/account/pacct >/dev/null 2>&1 || true
        systemctl enable --now psacct 2>/dev/null || true
    fi

    # Set shell session timeout
    echo "[*] Setting shell session idle timeout..."
    cat > /etc/profile.d/sysmode-timeout.sh <<'EOF'
# Lockdown mode: auto-logout idle shells after 10 minutes
TMOUT=600
readonly TMOUT
export TMOUT
EOF
    chmod 644 /etc/profile.d/sysmode-timeout.sh

    # Remount /proc with hidepid=2
    echo "[*] Remounting /proc with hidepid=2..."
    mount -o remount,hidepid=2,gid=proc /proc >/dev/null 2>&1 || \
        mount -o remount,hidepid=2 /proc >/dev/null 2>&1 || true
    if ! grep -q 'sysmode-hidepid' /etc/fstab 2>/dev/null; then
        echo "# sysmode-hidepid" >> /etc/fstab
        echo "proc  /proc  proc  defaults,hidepid=2,gid=proc  0  0  # sysmode-hidepid" >> /etc/fstab
    fi

    # Set account expiry date for the sysmode user
    echo "[*] Setting account expiry for $SYS_USER (3 years)..."
    local expiry_date
    expiry_date=$(date -d "+3 years" +%Y-%m-%d 2>/dev/null || date -v+3y +%Y-%m-%d 2>/dev/null || echo "")
    if [[ -n "$expiry_date" ]]; then
        chage -E "$expiry_date" "$SYS_USER" 2>/dev/null || true
    fi

    write_lynis lockdown

    echo "[+] Mode changed to: LOCKDOWN / FORTRESS (Extreme Hardening)"
    randomize_wallpaper

    echo ""
    echo "[!] Warning: Extreme hardening parameters are active."
    echo "    To exit LOCKDOWN mode and restore full relaxed access,"
    echo "    you must switch mode (e.g. secure/cyber) AND reboot your system."
}

