        iptables -I INPUT 1 -p tcp --tcp-flags ALL NONE -j DROP -m comment --comment "recon-deceiver-decoy" || true
        iptables -I INPUT 1 -p tcp --tcp-flags SYN,FIN SYN,FIN -j DROP -m comment --comment "recon-deceiver-decoy" || true
