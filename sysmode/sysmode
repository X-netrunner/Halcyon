    if mountpoint -q "$SYS_HOME/.local/share/fish" 2>/dev/null; then
        umount -l "$SYS_HOME/.local/share/fish" 2>/dev/null || true
    fi
    echo "[*] Mounting volatile fish history (RAM)..."
    mkdir -p "/run/sysmode-volatile/fish"
    chown "$SYS_USER:$SYS_USER" "/run/sysmode-volatile/fish"
    mkdir -p "$SYS_HOME/.local/share/fish"
    mount --bind "/run/sysmode-volatile/fish" "$SYS_HOME/.local/share/fish" 2>/dev/null || true
    cat > /etc/profile.d/sysmode-stealth-history.sh <<'EOF'
# sysmode stealth: keep bash history in the volatile RAM workspace
export HISTFILE="$HOME/Workspace/Stealth/.bash_history"
export HISTSIZE=100000
EOF
    chmod 644 /etc/profile.d/sysmode-stealth-history.sh

    # Encrypted NTP (NTS via time.cloudflare.com) so time sync doesn't
    # leak plaintext NTP metadata from the decoy persona.
    mkdir -p /etc/systemd/timesyncd.conf.d
    cat > /etc/systemd/timesyncd.conf.d/sysmode-stealth.conf <<'EOF'
[Time]
NTP=time.cloudflare.com
FallbackNTP=time.cloudflare.com time.nist.gov
EOF
    systemctl restart systemd-timesyncd || true

    # Disable disk-backed swap so the volatile workspace can't spill to disk
    # (zram is RAM-backed and kept enabled).
    echo "[*] Disabling disk-backed swap to keep volatile data RAM-only..."
    while read -r dev; do
        [[ "$dev" == /dev/zram* ]] && continue
        swapoff "$dev" 2>/dev/null || true
    done < <(swapon --show=NAME --noheadings 2>/dev/null)

    set_compilers stealth
    remove_blacklist
    write_audit_rules stealth
    write_banner stealth
    set_login_defs stealth
    set_shell_umask stealth
    set_core_dumps stealth
    set_home_perms stealth
    remove_lynis

    start_stealth_daemons

    echo "[+] Mode changed to: STEALTH (Relaxed & Stealthy)"
    randomize_wallpaper
}

# Honeypot (recon-deceiver, Cowrie), IDS (log-analyst) and the MAC-scan logger of stealth mode.
# Used by `set_stealth` and by `sysmode daemons`, which sysmode-daemons.service runs at every boot: the mode file
# survives a reboot but the daemons do not, so without this a freshly booted stealth system showed honeypot / IDS "off"
# until you switched mode again.
start_stealth_daemons() {
    # Start recon deceiver daemon (honeypot) via systemd
    echo "[*] Starting recon deception daemon (Lure Mode: Threshold 3)..."
    stop_pidfile /var/run/recon-deceiver.pid
    pkill -f recon-deceiver.py 2>/dev/null || true
    # Free port 22 for the Cowrie SSH honeypot, then start Cowrie before the
    # banner decoy so the decoy can skip binding 22 while Cowrie owns it.
    systemctl stop recon-deceiver.service 2>/dev/null || true
    # start_cowrie returns 1 when docker is missing / not running; under `set -e` that used to END this whole function
    # right here, so the honeypot, the IDS and the MAC logger below were never started (and the mode file already said stealth)
    start_cowrie || true
    if systemctl restart recon-deceiver.service >/dev/null 2>&1 && sleep 1 && pgrep -f recon-deceiver.py >/dev/null; then
        echo "[+] recon-deceiver.service running"
    elif [[ ! -f "$SCRIPTS_DIR/recon-deceiver.py" ]]; then
        echo "[!] $SCRIPTS_DIR/recon-deceiver.py not found (is the rice in $SYS_HOME/.config/Halcyon? set SYS_HOME in /etc/sysmode.conf)"
    else
        echo "[!] recon-deceiver.service unavailable or not running; starting the script directly..."
        start_bg recon-deceiver /var/run/recon-deceiver.pid python3 "$SCRIPTS_DIR/recon-deceiver.py" 3
    fi

    # Start log analyst daemon (IDS) via systemd
    echo "[*] Starting lightweight IDS log analyst..."
    stop_pidfile /var/run/log-analyst.pid
    pkill -f log-analyst.py 2>/dev/null || true
    pkill -f "hx ids" 2>/dev/null || true
    if systemctl restart log-analyst.service >/dev/null 2>&1 && sleep 1 && pgrep -f "log-analyst.py|hx ids" >/dev/null; then
        echo "[+] log-analyst.service running"
    else
        echo "[!] log-analyst.service unavailable or not running; starting the IDS directly..."
        if command -v hx >/dev/null; then
            start_bg log-analyst /var/run/log-analyst.pid hx ids
        elif [[ -f "$SCRIPTS_DIR/log-analyst.py" ]]; then
            start_bg log-analyst /var/run/log-analyst.pid python3 "$SCRIPTS_DIR/log-analyst.py"
        else
            echo "[!] neither hx nor $SCRIPTS_DIR/log-analyst.py found"
        fi
    fi

    # Start tcpdump MAC scanner logging if tcpdump is installed
    if [[ -x /usr/bin/tcpdump ]] || command -v tcpdump &>/dev/null; then
        local dump_iface
        if [[ -f /etc/sysmode.decoy-wifi ]]; then
            dump_iface=$(cat /etc/sysmode.decoy-wifi)
        elif command -v ip &>/dev/null; then
            dump_iface=$(ip route 2>/dev/null | awk '/^default/ {print $5; exit}')
        fi
        if [[ -z "$dump_iface" ]]; then
            dump_iface="wlan0"
        fi
        echo "[*] Starting tcpdump MAC scanner logging on interface $dump_iface..."
        stop_tcpdump
        mkdir -p "$LOGS_DIR"
        /usr/bin/tcpdump -i "$dump_iface" -e -n -l 'tcp[tcpflags] & (tcp-syn|tcp-fin) != 0 and (port 21 or port 22 or port 23 or port 25 or port 80 or port 3306 or port 3389 or port 445 or port 8080)' >> "$LOGS_DIR/attacker-mac-scans.log" 2>&1 &
        echo $! > /var/run/sysmode-tcpdump.pid
        chown "$SYS_USER:$SYS_USER" "$LOGS_DIR/attacker-mac-scans.log" || true
    else
        echo "[!] WARNING: tcpdump is not installed! Cannot start MAC scan logging."
    fi
}

# ---------------------------------------------------------------------------
# Reapply / late boot
# ---------------------------------------------------------------------------

reapply() {
    local mode
    mode=$(detect_mode)
    echo "[*] Re-applying $mode mode settings..."
    case "$mode" in
        lockdown) set_lockdown ;;
        secure) set_secure ;;
        stealth|hacking) set_stealth ;;
        cyber) set_cyber ;;
        *)
            echo "[*] Custom/Mixed mode ($mode) detected, skipping automatic reapplication."
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

action="${1:-status}"

# Ensure script is run with root privileges for modifications
if [[ "$action" != "status" && "$action" != "logs" && "$action" != "dossier" && "$action" != "verify" && "$action" != "check" && "$action" != "doctor" && "$action" != "help" && "$action" != "-h" && "$action" != "--help" ]]; then
    if [[ $EUID -ne 0 ]]; then
        echo "[!] This action must be run as root. Use: sudo sysmode $action" >&2
        exit 1
    fi
fi

case "$action" in
    secure)
        set_secure
        show_status
        ;;
    cyber)
        set_cyber
        show_status
        ;;
    hacking|stealth)
        persona_arg=""
        shift
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --hotspot)
                    DECOY_HOTSPOT=1
                    update_config "DECOY_HOTSPOT" "1"
                    ;;
                --no-hotspot)
                    DECOY_HOTSPOT=0
                    update_config "DECOY_HOTSPOT" "0"
                    ;;
                --persona)
                    persona_arg="${2:-}"
                    shift
                    ;;
                --persona=*)
                    persona_arg="${1#*=}"
                    ;;
                cisco|synology|ubuntu|debian)
                    persona_arg="$1"
                    ;;
            esac
            shift
        done
        set_stealth "$persona_arg"
        show_status
        ;;
    lockdown)
        set_lockdown
        show_status
        ;;
    reapply)
        reapply
        ;;
    daemons)
        # boot: bring the honeypot / IDS back for the saved mode (does not touch anything else)
        case "$(detect_mode)" in
            stealth|hacking)
                echo "[*] Boot: restoring stealth daemons..."
                start_stealth_daemons
                ;;
            *) echo "[*] Mode $(detect_mode) has no daemons to start." ;;
        esac
        ;;
    boot-late)
        # Late boot target to lock module loading under lockdown mode
        if [[ -f "$SYSMODE_MODE" ]] && [[ "$(cat "$SYSMODE_MODE")" == "lockdown" ]]; then
            echo "[*] Late Boot: Locking kernel module loading..."
            sysctl -w kernel.modules_disabled=1 || true
        fi
        ;;
    status)
        show_status
        ;;
    verify|check)
        verify_mode
        ;;
    doctor)
        run_doctor
        ;;
    logs)
        show_logs
        ;;
    dossier)
        run_dossier "${2:-}"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Usage: $0 {secure|cyber|stealth [--persona cisco|synology|ubuntu] [--hotspot|--no-hotspot]|lockdown|reapply|daemons|boot-late|status|verify|doctor|logs|dossier [IP]|help}" >&2
        exit 1
        ;;
esac
