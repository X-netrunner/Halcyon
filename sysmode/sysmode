EOF
    systemctl restart systemd-journald || true

    # Ensure sshd is unmasked if it was masked in lockdown
    systemctl unmask sshd 2>/dev/null || true
    rm -f /etc/ssh/sshd_config.d/sysmode-lockdown.conf

    # Volatile login accounting files (wtmp/btmp/lastlog) — bind-mount RAM
