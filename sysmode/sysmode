verify_mode() {
    local mode
    mode=$(detect_mode)
    echo "=== SYSMODE Integrity Verification & Verification ($mode profile) ==="
    local pass=0 fail=0

    check_val() {
        local label="$1" expected="$2" actual="$3"
        if [[ "$expected" == "$actual" ]]; then
            printf "  [\e[1;32m✓\e[0m] %-40s : %s\n" "$label" "$actual"
            (( pass++ )) || true
        else
            printf "  [\e[1;31m✗\e[0m] %-40s : Got '%s', Expected '%s'\n" "$label" "$actual" "$expected"
            (( fail++ )) || true
        fi
    }

    local fwd ptrace icmp compilers
    fwd=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo "N/A")
    ptrace=$(sysctl -n kernel.yama.ptrace_scope 2>/dev/null || echo "N/A")
    icmp=$(sysctl -n net.ipv4.icmp_echo_ignore_all 2>/dev/null || echo "0")

    if [[ -f /usr/bin/gcc ]] && [[ "$(stat -c '%a' /usr/bin/gcc 2>/dev/null)" == "700" ]]; then
        compilers="Strict"
    else
        compilers="Relaxed"
    fi

    case "$mode" in
        secure)
            check_val "IP Forwarding (net.ipv4.ip_forward)" "0" "$fwd"
            check_val "Compiler Permissions (gcc/clang/etc)" "Strict" "$compilers"
            check_val "Yama Ptrace Scope" "0" "$ptrace"
            check_val "ICMP Ignore All" "0" "$icmp"
            ;;
        stealth|hacking)
            check_val "IP Forwarding (net.ipv4.ip_forward)" "1" "$fwd"
            check_val "Compiler Permissions (gcc/clang/etc)" "Relaxed" "$compilers"
            check_val "ICMP Ignore All (Ping Stealth)" "1" "$icmp"
            local tmp_mounted="No"
            mountpoint -q "$STEALTH_WORKSPACE" && tmp_mounted="Yes"
            check_val "RAM Workspace Mounted ($STEALTH_WORKSPACE)" "Yes" "$tmp_mounted"
            local dns_act="No"
            systemctl is-active --quiet dnscrypt-proxy 2>/dev/null && dns_act="Yes"
            check_val "dnscrypt-proxy Active" "Yes" "$dns_act"
            ;;
        cyber)
            check_val "IP Forwarding (net.ipv4.ip_forward)" "1" "$fwd"
            check_val "Compiler Permissions (gcc/clang/etc)" "Relaxed" "$compilers"
            check_val "ICMP Ignore All" "0" "$icmp"
            ;;
        lockdown)
            check_val "IP Forwarding (net.ipv4.ip_forward)" "0" "$fwd"
            check_val "Compiler Permissions (gcc/clang/etc)" "Strict" "$compilers"
            check_val "Yama Ptrace Scope" "1" "$ptrace"
            check_val "ICMP Ignore All" "1" "$icmp"
            local ssh_active="No"
            systemctl is-active --quiet sshd 2>/dev/null && ssh_active="Yes"
            check_val "SSH Daemon Disabled (sshd)" "No" "$ssh_active"
            ;;
        *)
            echo "  [!] Custom/Mixed mode detected. Run 'sysmode status' for details."
            return 0
            ;;
    esac

    echo "------------------------------------------------"
    if [[ "$fail" -eq 0 ]]; then
        echo -e "\e[1;32m[+] All $pass verification checks PASSED for $mode mode!\e[0m"
    else
        echo -e "\e[1;31m[!] $fail check(s) FAILED out of $((pass+fail)) for $mode mode.\e[0m"
        echo "    Run 'sudo sysmode reapply' to restore expected settings."
    fi
}

