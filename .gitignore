# Local backups & runtime state
conf_backup/
*.bak
*.tmp
*.log
*.orig
*.before-halcyon*

# System & editor metadata
.DS_Store
Thumbs.db
*.swp
*~
sysmode/attacker-dossier
sysmode/log-analyst
sysmode/recon-deceiver
sysmode/setStaticMac
