# Compiled binaries & build artifacts
bin/*
!bin/.gitkeep
!bin/ai
!bin/advisor
!bin/notes
target/
**/target/
*.o
*.so
*.a

# Python bytecode & cache
__pycache__/
*.py[cod]

# Local backups & runtime state
greeting.conf
greeting-custom.txt
conf_backup/
*.bak
*.tmp
*.log
*.orig
*.before-halcyon*

# Editor & OS files
.DS_Store
Thumbs.db
*.swp
*~

# Per-machine files: created by install.sh / the island / scripts/gpu-mode.sh for THIS computer. They used to be committed, so
# a fresh install on another machine started with the author's GPU mode ("dgpu") and an NVIDIA hybrid-laptop gpu.lua.
# (Already tracking them in a git checkout? One time:  git rm --cached gpu-mode gpu.lua scheme/current.lua )
/gpu-mode
/gpu.lua
/scheme/current.lua
/special.conf
/apps.custom
/autostart.conf
/gamemode.conf

# Your own settings: install.sh / Settings write them and an update never overwrites them (KEEP_FILES in install.sh), so they
# do not belong in the repo either (scripts/sync-and-push.sh would commit them back otherwise)
/ai-advisor.conf
/backup-exclude.conf
/focus.conf
/focus-apps.conf
/notes.conf
/remind.conf
# install.sh links these to the built helpers in bin/ (absolute paths into one home folder)
/sysmode/recon-deceiver
/sysmode/log-analyst
/sysmode/attacker-dossier
/sysmode/setStaticMac
