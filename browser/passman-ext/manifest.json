{
  "manifest_version": 3,
  "name": "Halcyon passman",
  "version": "1.0.0",
  "description": "Asks to save the logins you type into the Halcyon vault (passman). Nothing leaves your computer.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content.js"], "all_frames": false, "run_at": "document_idle" }
  ]
}
